{
  "compilerOptions": {
    "target": "ES2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/index.ts", "scripts/**/*.ts", "*.config.ts", "tests/ui/**/*.ts"],
  "exclude": ["src/client", "tests/ui/**/*.spec.ts"]
}
